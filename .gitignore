node_modules/
.DS_Store
dist/
.remotion/
tmp/

# Credentials, Keys & Secrets (Strictly Ignored)
config/youtube-credentials.json
config/youtube-token.json
config/youtube-browser-session/
config/tiktok-browser-session/
config/projects/
config/*.json
!config/.gitkeep
.env
.env.local
.env.*
!.env.example
*.pem
*.key
*.token

# Large Rendered Video Binaries (>100MB / Video Exports)
exports/**/*.mp4
stories/**/exports/**/*.mp4
*.mp4

# Generated Storybook Projects (Audio, High-Res Plates, Raw PDFs, Pages & Exports)
# Exclude all generated stories to avoid repository bloat; keep only channel branding
stories/*
!stories/.gitkeep
!stories/branding/
!stories/branding/**
stories/branding/*.mp4
