# Storybook Assets & Manifests (Stored in Cloudflare R2: zayn-storybook)
# Git is kept ultra-clean (<5MB pure code). Run 'npm run story:pull <book>' or 'npm run story:pull-all' to restore locally.
stories/*
!stories/.gitkeep
!stories/branding/
!stories/branding/**
stories/**/exports/**/*.mp4
stories/**/raw/
stories/**/cache/

# Local POC experimental scripts
scripts/poc-*.ts
