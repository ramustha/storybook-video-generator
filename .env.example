# ==============================================================================
# Environment Secrets & Configuration Template
# Copy this file to .env and fill in your secrets.
# NEVER commit .env to GitHub or any version control system.
# ==============================================================================

# --- Google Cloud & YouTube Data API v3 OAuth Secrets ---
# Option A (Recommended for CI / Production): Discrete Environment Secrets
YOUTUBE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
YOUTUBE_CLIENT_SECRET="your-google-oauth-client-secret"
YOUTUBE_REDIRECT_URI="http://localhost:3000/oauth2callback"
YOUTUBE_REFRESH_TOKEN="your-offline-refresh-token"
YOUTUBE_ACCESS_TOKEN=""

# Option B (Alternative for GitHub Actions): Entire JSON Secrets as String/Base64
# YOUTUBE_CREDENTIALS_JSON='{"installed":{"client_id":"...","client_secret":"..."}}'
# YOUTUBE_TOKEN_JSON='{"access_token":"...","refresh_token":"...","scope":"...","token_type":"Bearer"}'

# --- AI Visual & Image Generation Secrets (Optional) ---
# Required only if generating fresh AI illustrations via Gemini Imagen 3
GEMINI_API_KEY="your-gemini-api-key"

# --- Voice Cloning & Custom Speech Synthesis (Optional) ---
# Default pipeline uses Microsoft Azure Neural Voice (msedge-tts) for free.
# Only required if using ElevenLabs voice cloning:
ELEVENLABS_API_KEY=""
